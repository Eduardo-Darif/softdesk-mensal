# Credenciais do SoftDesk usadas pelo coletar_chamados.py
# Copie este arquivo para .env e preencha. O .env NÃO é versionado (está no .gitignore).
SOFTDESK_USER=edr
SOFTDESK_PASS=sua_senha_aqui

# --- Certificado (o SoftDesk interno usa certificado próprio) ---
# Rota rápida (sistema interno confiável): desliga a verificação de certificado.
SOFTDESK_VERIFY_SSL=false
# Rota segura (opcional): em vez do de cima, aponte para a CA da Martinelli em .pem
# SOFTDESK_CA_BUNDLE=C:\caminho\martinelli-ca.pem
