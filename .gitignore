# ─────────────────────────────────────────────────────────────
# Credenciais — NUNCA versionar
# ─────────────────────────────────────────────────────────────
.env

# ─────────────────────────────────────────────────────────────
# Ambiente virtual Python
# Recriável a qualquer momento: o iniciar.bat gera a venv e roda
#   pip install -r backend/requirements.txt   na primeira execução.
# Por isso NÃO precisa (nem deve) ser versionado/copiado junto.
# ─────────────────────────────────────────────────────────────
venv/
backend/venv/

# Caches e artefatos do Python
__pycache__/
*.py[cod]
*.pyd
*.egg-info/

# Logs e estado gerados pelo coletor
*.log
backend/data/status_coleta.json

# Cópias de histórico geradas automaticamente pelo backend.
# Por padrão ficam versionadas (para não perder os snapshots mensais).
# Se você NÃO quiser versioná-las, descomente a linha abaixo:
# backend/data/historico/

# Arquivos de sistema / editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# ─────────────────────────────────────────────────────────────
# Dados internos (repositório público) — NÃO versionar
# ─────────────────────────────────────────────────────────────
backend/data/*.xlsx
backend/data/historico/
Claude outputs/
*.bak-*
